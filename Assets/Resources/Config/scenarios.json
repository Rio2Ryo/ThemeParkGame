    {
      "id": "tutorial_beginner",
      "type": "tutorial",
      "nameJa": "チュートリアル - はじめてのテーマパーク",
      "nameEn": "Tutorial - Your First Theme Park",
      "difficulty": "Easy",
      "startingMoney": 100000,
      "startingZone": "LostKingdom",
      "description": "テーマパーク経営の基本を学ぶチュートリアルシナリオ。ガイド付きで一つずつ操作を覚えながら、小さなパークを完成させよう。時間制限なし・失敗なし。",
      "mapSize": "Small",
      "startingStaff": 2,
      "weatherBias": "Sunny",
      "timeLimitMonths": 0,
      "tutorialEnabled": true,
      "failureDisabled": true,
      "startingFacilities": [
        { "type": "ParkEntrance", "position": { "x": 0, "z": 0 } },
        { "type": "Path", "positions": [
          { "x": 0, "z": 0 }, { "x": 1, "z": 0 }, { "x": 2, "z": 0 },
          { "x": 3, "z": 0 }, { "x": 4, "z": 0 }, { "x": 5, "z": 0 }
        ]}
      ],
      "initialResearch": ["res_lk_cups", "res_lk_ferris"],
      "tutorialSteps": [
        {
          "step": 1,
          "titleJa": "通路を敷こう",
          "descriptionJa": "まず入口から通路を伸ばしましょう。来場者が歩くには通路が必要です。",
          "requiredAction": "place_pathway",
          "targetCount": 5
        },
        {
          "step": 2,
          "titleJa": "アトラクションを建設",
          "descriptionJa": "通路に沿ってアトラクションを1つ建てましょう。「ファラオの回転杯」がおすすめです。",
          "requiredAction": "build_attraction",
          "targetCount": 1
        },
        {
          "step": 3,
          "titleJa": "ショップを建設",
          "descriptionJa": "来場者はお腹が空きます。フードショップを1つ建てましょう。",
          "requiredAction": "build_shop",
          "targetCount": 1
        },
        {
          "step": 4,
          "titleJa": "トイレを建設",
          "descriptionJa": "来場者にはトイレも必要です。通路の近くに配置しましょう。",
          "requiredAction": "build_toilet",
          "targetCount": 1
        },
        {
          "step": 5,
          "titleJa": "スタッフを雇おう",
          "descriptionJa": "メカニック1人とスイーパー1人を雇いましょう。アトラクションの故障と清掃に必要です。",
          "requiredAction": "hire_staff",
          "targetCount": 2
        },
        {
          "step": 6,
          "titleJa": "開園！",
          "descriptionJa": "準備完了！ゲーム速度を1倍にして来場者を迎え入れましょう。",
          "requiredAction": "set_speed_1",
          "targetCount": 1
        },
        {
          "step": 7,
          "titleJa": "来場者を観察",
          "descriptionJa": "来場者をタップして満足度を確認しましょう。感情バブルの色で状態がわかります。",
          "requiredAction": "tap_visitor",
          "targetCount": 3
        },
        {
          "step": 8,
          "titleJa": "2つ目のアトラクション",
          "descriptionJa": "来場者が増えたら2つ目のアトラクションを建設しましょう。バリエーションが評価を上げます。",
          "requiredAction": "build_attraction",
          "targetCount": 1
        }
      ],
      "objectives": [
        {
          "type": "attractionCount",
          "target": 2,
          "description": "アトラクションを2つ建設する"
        },
        {
          "type": "visitorCount",
          "target": 30,
          "description": "累計来場者数30人を達成"
        },
        {
          "type": "parkRating",
          "target": 30,
          "description": "パーク評価30を達成"
        }
      ],
      "completionReward": {
        "money": 20000,
        "unlockMessage": "おめでとう！基本操作をマスターしました。サンドボックスモードやシナリオモードに挑戦しよう！"
      }
    },
